pkgname=resketch-git
pkgver=1.5.0.r48.196e179
pkgrel=1
pkgdesc='Open-source Figma client for Linux!'
arch=('x86_64')
url='https://github.com/Ralsei-x64/ReSketch'
license=('GPL-3.0-only')
depends=(
    'glibc'
    'gcc-libs'
    'gtk3'
    'qt6-base>=6.8'
    'qt6-declarative>=6.8'
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'cups'
    'dbus'
    'expat'
    'libdrm'
    'libx11'
    'libxcomposite'
    'libxdamage'
    'libxfixes'
    'libxi'
    'libxrandr'
    'libxrender'
    'libxkbcommon'
    'mesa'
    'nspr'
    'nss'
    'kirigami'
    'kdeclarative'
    'kiconthemes>=6.3'
    'qqc2-desktop-style'
    'kwindowsystem'
    'knotifications'
    'kcolorscheme>=6.6'
    'breeze'
    'fontconfig'
    'freetype2'
)
makedepends=('cmake>=3.21' 'git' 'ninja' 'vulkan-headers')
optdepends=(
    'polkit: In-app system package updates'
    'qt6-wayland: Native Wayland support'
    'breeze-icons: Fallback desktop icons'
)
provides=("resketch=$pkgver")
conflicts=('resketch')
source=('resketch::git+https://github.com/Ralsei-x64/ReSketch.git#branch=main')
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/resketch"
    local version
    version=$(sed -n 's/^project(ReSketch VERSION \([^ ]*\) .*/\1/p' CMakeLists.txt)
    printf '%s.r%s.%s\n' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cmake -S "$srcdir/resketch" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
